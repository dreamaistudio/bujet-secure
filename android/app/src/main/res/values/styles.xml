<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Every screen in this app is dark. The DayNight parent below means that
        on a phone set to light mode Android painted the status bar and the
        navigation bar white, so a black app sat inside two white bars and the
        status bar icons were almost invisible against them.

        The four lines added here pin both bars to the app's own background
        colour and keep their icons light, from the very first frame. The JS
        StatusBar plugin cannot do this - it runs too late and cannot touch the
        navigation bar at all.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#09090b</item>
        <item name="android:navigationBarColor">#09090b</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <!--
        This is the theme the app actually runs under: AndroidManifest.xml sets it
        on MainActivity and nothing swaps it afterwards, so it governs the status
        bar and navigation bar for the whole session - not just the splash. The
        same four lines therefore have to be repeated here, or the bars fall back
        to the phone's light mode and turn white around the dark app.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#09090b</item>
        <item name="android:navigationBarColor">#09090b</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
